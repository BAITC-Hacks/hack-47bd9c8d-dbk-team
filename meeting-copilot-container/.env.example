# Конфигурация голосового стека ai.kdb.kz
AI_KDB_URL=https://ai.kdb.kz
AI_KDB_TOKEN=your-ai-kdb-token
AI_KDB_IP=0.0.0.0

# Настройки OpenRouter (суммаризация)
OPEN_ROUTER_URL=https://openrouter.example.com/v1/chat/completions
OPEN_ROUTER_AUTH_BEARER=your-openrouter-token
OPEN_ROUTER_MODEL=zai-org/GLM-5.3

# Настройки MinIO (хранилище входных/выходных файлов)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=uploads
MINIO_SECURE=false

# Настройки Kafka (RecognitionRequest / RecognitionResponse)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REQUEST_TOPIC=AiMeetingCopilotRequest
KAFKA_RESPONSE_TOPIC=AiMeetingCopilotResponse
KAFKA_CONSUMER_GROUP=ai-meeting-copilot
PROCESSING_TIMEOUT_SECONDS=1800

# Общие настройки
DEFAULT_PROVIDER=kdb
DEFAULT_LANGUAGE=ru
