# Конфигурация AiMeetingCopilot.
#
# Скопировать в .env и заполнить токены внешних сервисов:
#   cp .env.example .env
#
# Значения Kafka и MinIO уже настроены на локальный стек из ../infrastructure
# (поднимается одной командой: cd ../infrastructure && ./local-up.sh).
# Плейсхолдеры change-me-* — секреты, их надо подставить самостоятельно;
# в git они не попадают, .env под .gitignore.

# --- Речевая служба: распознавание и диаризация ----------------------------
# speech_stack - собственный стек команды (исходники в ../speech_stack),
#                развёрнут на stt.aibots.kz;
# kdb          - корпоративный голосовой стек ai.kdb.kz.
DEFAULT_PROVIDER=speech_stack

# --- speech_stack (stt.aibots.kz) ------------------------------------------
# Распознавание и диаризация за одним шлюзом и одним токеном:
#   POST /v1/audio/transcriptions   речь -> текст (OpenAI-совместимо)
#   POST /v1/audio/diarize          кто когда говорил
#   GET  /health, /health/diar      пробы, токен не нужен
# Неизвестные пути шлюз тоже закрывает 401, поэтому 401 — не обязательно
# плохой токен, проверьте заодно путь.
SPEECH_STACK_URL=https://stt.aibots.kz
STT_TOKEN=change-me-stt-token
# Принимаются и имена из рабочего .env команды: STT_BASE_URL и STT_API_KEY
# Язык распознавания: ru | kk | en | auto. Пусто — берётся DEFAULT_LANGUAGE.
# auto отдаёт route и detected_language, но на шумной записи детектор уходит
# к соседям казахского и модель начинает сочинять — если язык известен,
# задавайте его явно.
SPEECH_STACK_LANGUAGE=
# Собственные имена через запятую — повышают точность ФИО в расшифровке.
SPEECH_STACK_HOTWORDS=

# --- ai.kdb.kz (альтернативный провайдер, DEFAULT_PROVIDER=kdb) ------------
AI_KDB_URL=https://ai.kdb.kz
AI_KDB_TOKEN=change-me-ai-kdb-token
AI_KDB_IP=

# --- Суммаризация (OpenAI-совместимый endpoint) ----------------------------
# Языковая модель — СВОЯ. Текст совещания не должен уходить во внешние облака:
# это прямое ограничение кейса. Эндпоинт OpenAI-совместимый.
LLM_API_URL=https://vllm.aibots.kz/v1/chat/completions
LLM_API_KEY=change-me-llm-token
LLM_MODEL=qwen3-vl-30b-instruct

# Принимаются и имена VLLM_BASE_URL / VLLM_API_KEY / VLLM_MODEL — так они
# названы в рабочем .env команды и в tools/extract_commitments.py. Адрес можно
# давать и до /v1: путь /chat/completions дописывается сам.
#
# Старые имена тоже принимаются — на них настроены прежние .env:
# OPEN_ROUTER_URL (полный endpoint), OPEN_ROUTER_AUTH_BEARER, OPEN_ROUTER_MODEL

# --- MinIO (хранилище входных/выходных файлов) -----------------------------
# Локальный стек: ../infrastructure/local-up.sh
#   S3 API       http://localhost:9000
#   веб-консоль  http://localhost:9001  (root-креды: minioadmin / minioadmin123)
#
# Ходим под app-юзером copilot-app — у него политика copilot-uploads-rw,
# права только на бакет uploads. Endpoint задаётся БЕЗ схемы (host:port),
# протокол выбирается флагом MINIO_SECURE.
#
# Если воркер запускается контейнером в сети стека — заменить на minio:9000.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=copilot-app
MINIO_SECRET_KEY=copilot-app-local
MINIO_BUCKET=uploads
MINIO_SECURE=false

# --- Kafka (RecognitionRequest / RecognitionResponse) ----------------------
# Локальный стек слушает на 127.0.0.1:9094 (HOST-листенер, PLAINTEXT, без auth).
# Веб-интерфейс Kafbat UI: http://localhost:8080 (admin / kafka-ui-local).
#
# Если воркер запускается контейнером в сети стека — заменить на kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_REQUEST_TOPIC=AiMeetingCopilotRequest
KAFKA_RESPONSE_TOPIC=AiMeetingCopilotResponse
KAFKA_CONSUMER_GROUP=ai-meeting-copilot
# Таймаут обработки одного сообщения; по истечении в Kafka уходит ошибка TIMEOUT
PROCESSING_TIMEOUT_SECONDS=1800

# --- Общие настройки -------------------------------------------------------
# DEFAULT_PROVIDER задаётся выше, рядом с настройками речевых служб
DEFAULT_LANGUAGE=ru
