# --- Traefik / Let's Encrypt ---
# Базовый домен: нужны A-записи traefik., s3., s3-console., kafka-ui., copilot.
# на публичный IP машины, порты 80/443 открыты (HTTP-01 challenge).
DOMAIN=example.com
ACME_EMAIL=admin@example.com
# Staging CA — для отладки (нет rate-limit, сертификаты недоверенные).
# Боевой: https://acme-v02.api.letsencrypt.org/directory
LE_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# htpasswd-строка для дашборда traefik: htpasswd -nb admin 'пароль'
# ВАЖНО: compose интерполирует значения в .env — каждый $ удваивать ($$),
# иначе $apr1 будет воспринят как переменная и строка сломается.
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$REPLACE_ME

# --- Kafka ---
# Сгенерировать: docker run --rm apache/kafka:3.9.0 /opt/kafka/bin/kafka-storage.sh random-uuid
# (должен быть base64-UUID ровно 22 символа, иначе брокер не стартует)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_UI_PASSWORD=change-me-kafka-ui

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-root
MINIO_APP_USER=copilot-app
MINIO_APP_PASSWORD=change-me-copilot-app
MINIO_BUCKET=uploads
# Бакеты, которые создаст mc-init (пробел-сепаратор).
# uploads — воркер; recordings/results — фронт (front/);
# zoom-ingest — state-дедупликация сервиса zoom-ingest (services/zoom-ingest/).
MINIO_BUCKETS=uploads recordings results zoom-ingest

# --- meeting-copilot worker ---
# Образ воркера (собран из Dockerfile.service) или build-ссылка на свой registry
COPILOT_IMAGE=registry.example.com/project/ai-meeting-copilot:main
# Whisper-compatible API распознавания речи
AI_API_URL=https://ai.example.com
AI_API_TOKEN=change-me-ai-token
# ПОЛНЫЙ endpoint LLM-прокси, включая путь /v1/chat/completions
OPEN_ROUTER_URL=https://llm-proxy.example.com/v1/chat/completions
OPEN_ROUTER_AUTH_BEARER=change-me-llm-token

# --- copilot-ui ---
COPILOT_UI_IMAGE=registry.example.com/project/copilot-ui:main
# Пустое значение = токен не требуется
COPILOT_UI_TOKEN=change-me-ui-token
