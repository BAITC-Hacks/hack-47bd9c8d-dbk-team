# Конфигурация ЛОКАЛЬНОГО стека (docker-compose.yml + docker-compose.local.yml).
#
# Всё здесь — dev-значения для запуска на своей машине: порты слушают только
# 127.0.0.1, наружу ничего не смотрит. В прод эти креды не переносить,
# для него есть .env.example с traefik/Let's Encrypt.
#
# Копируется в .env скриптом ./local-up.sh (если .env ещё нет).
#
# Имя файла — без ведущей точки: корневой .gitignore прячет всё по маске
# `.env.*` (правило «секреты не в GitHub»), и шаблон с точкой в репозиторий
# бы не попал.

# --- Traefik / Let's Encrypt ---
# Локально traefik не поднимается (профиль `tls` в docker-compose.local.yml),
# но compose всё равно подставляет эти переменные при разборе файла —
# поэтому они заданы заглушками, чтобы не было предупреждений.
DOMAIN=localhost
ACME_EMAIL=admin@localhost
LE_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$REPLACE_ME

# --- Kafka ---
# base64-UUID ровно 22 символа. Перегенерировать:
#   docker run --rm apache/kafka:3.9.0 /opt/kafka/bin/kafka-storage.sh random-uuid
# ВАЖНО: менять только вместе с пересозданием тома kafka-data —
# брокер не стартует, если cluster.id в томе не совпадает с этим значением.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# Логин к Kafbat UI: admin / это значение
KAFKA_UI_PASSWORD=kafka-ui-local

# --- MinIO ---
# root — для веб-консоли (http://localhost:9001)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# app-юзер — под ним ходит meeting-copilot, права только на бакет uploads
MINIO_APP_USER=copilot-app
MINIO_APP_PASSWORD=copilot-app-local
# Политика copilot-uploads-rw.json прибита к имени бакета `uploads`:
# при смене MINIO_BUCKET поправить Resource в minio/copilot-uploads-rw.json
MINIO_BUCKET=uploads

# --- meeting-copilot worker (профиль `app`, локально не поднимается) ---
COPILOT_IMAGE=meeting-copilot-service:latest
AI_API_URL=https://ai.kdb.kz
AI_API_TOKEN=change-me-ai-token
OPEN_ROUTER_URL=https://llm-proxy.example.com/v1/chat/completions
OPEN_ROUTER_AUTH_BEARER=change-me-llm-token

# --- copilot-ui (профиль `app`, локально не поднимается) ---
COPILOT_UI_IMAGE=copilot-ui:latest
COPILOT_UI_TOKEN=
