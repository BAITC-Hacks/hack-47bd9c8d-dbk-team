# Copy to .env and fill in. .env is gitignored — share real values via a secure channel.

# GLM router (Zhipu GLM-5.3 via jas.vc)
GLM_AUTH_BEARER=
GLM_ROUTER_URL=https://openrouter.jas.vc:40443/v1/models
GLM_BASE=https://openrouter.jas.vc:40443/v1

# Baiterek LLM gateway (LiteLLM, OpenAI-compatible)
BAITEREK_LLM_GATEWAY_URL=llm.baiterek.gov.kz
BAITEREK_LLM_GATEWAY_API_KEY=
BAITEREK_LLM_BASE=https://llm.baiterek.gov.kz/v1

# gbrain providers (same Baiterek key)
LITELLM_BASE_URL=https://llm.baiterek.gov.kz/v1
LITELLM_API_KEY=
DEEPSEEK_API_KEY=

# Hackathon-issued
OPENAI_API_KEY=
NVIDIA_API_KEY=

# MCP services
FIRECRAWL_API_KEY=
API_KEY_21ST=
CONTEXT7_API_KEY=

# Zoom Cloud Recording ingest (docs/tecspec/zoom-cloud-recording.md)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# email/ID хоста; пусто = все пользователи аккаунта
ZOOM_USER_ID=
# webhook verification token — для v2 (webhook recording.completed)
ZOOM_WEBHOOK_SECRET_TOKEN=

# Cloudflare (deploy + tunnel; lead's account)
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=
