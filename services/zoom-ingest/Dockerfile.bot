FROM python:3.12-slim

# chromium + pulseaudio + ffmpeg: бот входит во встречу через веб-клиент,
# звук уходит в null-sink, ffmpeg пишет sink.monitor.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg pulseaudio \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt playwright \
    && playwright install --with-deps chromium
COPY zoom_ingest ./zoom_ingest
COPY docker/bot-entrypoint.sh /bot-entrypoint.sh
RUN chmod +x /bot-entrypoint.sh

ENTRYPOINT ["/bot-entrypoint.sh"]
