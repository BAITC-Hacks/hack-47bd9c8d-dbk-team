# Zoom Server-to-Server OAuth (Zoom Marketplace → Build App)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# email/ID хоста, чьи записи забираем; пусто = все пользователи аккаунта
ZOOM_USER_ID=
# webhook verification token — для v2 (webhook recording.completed), поллеру не нужен
ZOOM_WEBHOOK_SECRET_TOKEN=

ZOOM_POLL_INTERVAL_SEC=120
ZOOM_LOOKBACK_DAYS=1

KAFKA_BROKERS=localhost:9092
TOPIC_UPLOADED=meetings.uploaded
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false
RECORDINGS_BUCKET=recordings
STATE_BUCKET=zoom-ingest
LANG_HINT=auto
