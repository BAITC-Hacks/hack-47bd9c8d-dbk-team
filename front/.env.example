# Copy to .env (gitignored). Defaults match the team contract (.planning/tasks/CONTRACT.md).

# Kafka / Redpanda
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=meeting-copilot-front
KAFKA_GROUP_ID=meeting-copilot-front-ui
TOPIC_UPLOADED=meetings.uploaded
TOPIC_READY=meetings.ready
TOPIC_FAILED=meetings.failed

# MinIO (S3)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
RECORDINGS_BUCKET=recordings
RESULTS_BUCKET=results

# UI language hint sent with meetings.uploaded (ru | kz | en | auto)
LANG_HINT=auto

# Demo mode without Kafka/MinIO: serves mock/sample-result.json
MOCK_MODE=false
