# --- секреты: в репозиторий не едут никогда (правило организаторов) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*credentials*.json

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / Next.js ---
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.npm/
.eslintcache

# --- Docker / инфраструктура ---
docker-compose.override.yml
infrastructure/.env
infrastructure/letsencrypt/
infrastructure/data/

# --- данные и артефакты выполнения ---
data/
uploads/
artifacts/
*.log
tmp/
.cache/

# --- скриншоты и черновики для обсуждения, не часть решения ---
docs/screenshots/
docs/image.png

# --- локальное состояние агентов и инструментов ---
.claude/
.codex/*
!.codex/hooks.json
.agents/
.gbrain
.gbrain-owner.json
skills-lock.json
.kiro/

# --- материализация страниц gbrain (живут в мозге, не в git) ---
decisions/

# --- клоны инструментов (ставятся через tools/dev-workflow-setup.sh) ---
# Всё в tools/ — внешнее, кроме наших собственных скриптов и playbook'ов.
tools/*
!tools/*.sh
!tools/*.py
!tools/*.yaml
!tools/dev-workflow/

# --- внутренние playbook'и команды (раздаются через tools/dev-workflow/) ---
/AGENTS.md
/HACKATHON.md

# --- ОС и редакторы ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
